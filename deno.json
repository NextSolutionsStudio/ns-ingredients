{
  "name": "@nextsolutions/ns-ingredients",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-read src/main.ts",
    "test": "deno test --allow-read --allow-env --allow-net",
    "test:golden": "deno run --allow-read scripts/golden-report.ts",
    "check": "deno check src/main.ts src/cli/keys.ts scripts/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "kb:validate": "deno run --allow-read scripts/kb-validate.ts",
    "kb:wikidata": "deno run --allow-net --allow-write=kb/generated scripts/import-wikidata.ts",
    "keys": "deno run --allow-net --allow-env --allow-read src/cli/keys.ts",
    "openapi": "deno run --allow-read --allow-env scripts/openapi.ts",
    "smoke": "deno run --allow-net --allow-env scripts/smoke.ts",
    "bench": "deno bench --allow-read"
  },
  "imports": {
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.1.0",
    "hono": "npm:hono@^4.9.0",
    "zod": "npm:zod@^4.1.0",
    "postgres": "npm:postgres@^3.4.7",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.3.16",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "fast-check": "npm:fast-check@^3.23.0"
  },
  "fmt": {
    "lineWidth": 110,
    "exclude": [
      "kb/",
      "docs/",
      "*.md"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}

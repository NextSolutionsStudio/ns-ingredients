# Copy to .env (never commit it). Every variable is optional for local development.
# postgresql://user:password@host:5432/db in production; pglite:memory or pglite:./.data locally.
DATABASE_URL=pglite:./.data
PORT=8029
HOST=0.0.0.0
KB_DIR=./kb
# Comma-separated browser origins allowed to call /v1/*. Empty = CORS off.
CORS_ORIGINS=
LOG_LEVEL=info
PUBLIC_BASE_URL=https://ingredients.nextsolutions.studio
KEY_CACHE_SECONDS=60
USAGE_FLUSH_SECONDS=10
